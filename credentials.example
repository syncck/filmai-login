# ==============================================================================
# filmai-login configuration
#
# Target file path : ~/.config/filmai-login/.filmai_credentials
# File permissions : chmod 600 ~/.config/filmai-login/.filmai_credentials
# ==============================================================================

# Account Credentials
# Your login credentials for the target service
USERNAME="your_username"
PASSWORD="your_password"

# WireGuard Client Configuration
# Generate keys using wgcf (see README for generation steps)
# WIREGUARD_PRIVATE_KEY: 'PrivateKey' from wgcf-profile.conf
WIREGUARD_PRIVATE_KEY="your_private_key"

# WIREGUARD_ADDRESSES: 'Address' from wgcf-profile.conf (IPv4/32)
WIREGUARD_ADDRESSES="172.16.0.2/32"

# Automated Updates
# Set to true to check the GitHub repository and auto-update before each run
AUTO_UPDATE=true

# Optional: Host proxy port (default: 8888; change if 8888 collides with existing services)
# PROXY_PORT="8888"

# Optional: Directory for runtime files (log, cookies, debug HTML); defaults to script directory
# APP_DIR="/opt/filmai-login"
